{
  "mcpServers": {
    "neo4j": {
      "command": "sh",
      "args": [
        "-c",
        "set -a; . \"$HOME/.config/nest/neo4j-personal.env\"; set +a; exec npx -y @alanse/mcp-neo4j-server"
      ]
    },
    "neo4j-shared": {
      "command": "sh",
      "args": [
        "-c",
        "set -a; . \"$HOME/.config/nest/neo4j.env\"; set +a; exec npx -y @alanse/mcp-neo4j-server"
      ]
    }
  }
}
