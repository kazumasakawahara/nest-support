# SOS 緊急通知サービス設定
#
# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
LINE_GROUP_ID=YOUR_GROUP_ID

# CORS（本番環境では適切に設定）
# CORS_ORIGINS=https://your-domain.com

# アプリ内認証（本人の確認の入口 /api/client/{仮名}）用の共有シークレット。名前は返さない。
# SOS 送信（POST /api/sos）は非対称設計により無認証。
APP_ACCESS_TOKEN=YOUR_APP_ACCESS_TOKEN
SESSION_COOKIE_SECURE=true
BIND_HOST=127.0.0.1
