# Neo4j 接続設定（障害福祉 support-db）
# Neo4j 認証は ~/.config/nest/neo4j.env を参照（NEO4J_URI / NEO4J_USERNAME / NEO4J_PASSWORD はここに書かない。~/.zshrc が自動で読み込む）

# 生活困窮者自立支援（livelihood-support / port 7688）は 2026-05 に廃止。
# 環境変数も撤去済み（再開する場合は decommissioned/README.md を参照）。

# --- Gemini（Google の API）---
# GEMINI_API_KEY を設定しても、送る印にはならない。
# 機能ごとの設定（~/.config/nest/external-api-features.json）と
# 契約の確認の記録（~/.config/nest/external-api-record.json）がそろうまで送らない（docs/external-api.md）。
# 使う場面：音声の文字起こし（NEXT-03）・手書きの OCR（NEXT-04）。
# 多機能インポーターは文字を取り出すだけで、構造化も DB への登録もしない。
GEMINI_API_KEY=
# GEMINI_GENERATION_MODEL: 文字起こし・OCR に使う生成モデル（既定 gemini-2.5-pro）
# GEMINI_GENERATION_MODEL=gemini-2.5-pro
# LINE Messaging API（SOS通知用）
LINE_CHANNEL_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
LINE_GROUP_ID=YOUR_GROUP_ID

# CORS設定（field-ui / sos 共通、カンマ区切りで複数指定可能）
# 未設定時は CORS 無効（同一オリジンのみ許可）。ワイルドカード '*' は不可。
# CORS_ALLOW_ORIGINS=https://example.com,https://app.example.com

# 仮名化スキーマ（マイグレーション後に true に設定）
PSEUDONYMIZATION_ENABLED=false
# 仮名化モード: "mask"（部分マスク●）, "pseudonym"（架空名に置換）
PSEUDONYMIZATION_MODE=mask
# 仮名化シード値（pseudonymモードで同じ入力→同じ出力を保証するキー）
PSEUDONYMIZATION_SEED=nest-support-demo

# ── アプリ内認証（field-ui / sos の情報取得エンドポイント）──
# 共有シークレット。field-ui/sos の /api/* は Authorization: Bearer <token> または
# /api/login が発行するセッション Cookie で認証する。未設定だと保護 API は 503。
# SOS 送信（POST /api/sos）は緊急導線のため無認証（非対称設計）。
APP_ACCESS_TOKEN=change-me-to-a-long-random-secret
# セッション Cookie の Secure 属性（HTTPS 前提の本番は true。ローカル HTTP 検証時のみ false）
SESSION_COOKIE_SECURE=true
# サービスのバインドアドレス（既定 127.0.0.1。TLS/認証はリバースプロキシに委譲）
BIND_HOST=127.0.0.1
# 監査ログの操作者名に X-Authenticated-User ヘッダを採用するか（既定 false）。
# 外部由来ヘッダを剥がして付与する信頼できるリバースプロキシ配下でのみ true にする。
# false のままだと監査操作者は "authenticated" 固定（ヘッダなりすまし防止）。
TRUST_PROXY_HEADERS=false
